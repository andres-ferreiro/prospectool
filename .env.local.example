# Mapbox public token — map rendering + address search. https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# INEGI DENUE API token — server-only. https://www.inegi.org.mx/servicios/api_denue.html
DENUE_TOKEN=

# Supabase project — server-only (all DB access goes through Next.js route
# handlers, never the browser). Find these under Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same Supabase project, public-prefixed — used by the browser client for
# signup/login/signout. Same values as above, just exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key — server-only, used for AI-assisted keyword suggestion
# during project creation. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe — server-only. All billing goes through route handlers; the browser
# never talks to Stripe directly (Checkout is a redirect). Test-mode keys
# during development. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# locally, or the endpoint's signing secret in the Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=
# Price/coupon IDs created in the Stripe Dashboard — see docs/superpowers/plans.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_COUPON_FIRST_MONTH=

# Supabase service-role key — server-only, NEVER expose to the browser. Used
# solely by the Stripe webhook, which has no user session and must bypass
# RLS to write subscription rows. Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
